-
  var journalPosts = site.posts.sort('date', -1)
  var recentPosts = journalPosts.limit(5).toArray()
  var firstPost = site.posts.sort('date').first()
  var sinceYear = firstPost ? date(firstPost.date, 'YYYY') : ''

section#vexpaer-blog-gateway.vexpaer-journal(aria-labelledby='vexpaer-blog-gateway-title' data-home-panel='blog' data-tone='light')
  .vexpaer-journal__inner
    header.vexpaer-journal__head
      p.vexpaer-journal__label(data-reveal)
        span 01
        span Journal
      h2#vexpaer-blog-gateway-title(data-reveal) Blog
      p.vexpaer-journal__lead(data-reveal) Study notes, paper readings and course write-ups, gathered slowly over time.

      dl.vexpaer-journal__stats(data-reveal)
        div
          dt Posts
          dd= site.posts.length
        div
          dt Tags
          dd= site.tags.length
        if sinceYear
          div
            dt Since
            dd= sinceYear

      nav.vexpaer-journal__links(data-reveal aria-label='Blog links')
        a.vexpaer-journal__cta(href=url_for('/blog/'))
          span All posts
          i(aria-hidden='true') →
        a(href=url_for('/archives/')) Archives
        a(href=url_for('/tags/')) Tags

    section.vexpaer-journal__recent(aria-labelledby='vexpaer-journal-recent-title')
      h3#vexpaer-journal-recent-title.vexpaer-journal__caption(data-reveal) Latest
      ol.vexpaer-journal__list
        each post in recentPosts
          - var firstTag = post.tags && post.tags.length ? vexpaer_en_tag(post.tags.toArray()[0].name) : ''
          li(data-reveal)
            a(href=url_for(post.path))
              time(datetime=date(post.date, 'YYYY-MM-DD'))= date(post.date, 'YYYY.MM.DD')
              span.vexpaer-journal__title= vexpaer_en_title(post)
              if firstTag
                span.vexpaer-journal__tag= firstTag
              i(aria-hidden='true') →
