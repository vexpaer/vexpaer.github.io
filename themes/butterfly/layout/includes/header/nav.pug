nav#nav
  span#blog_name
    a#site-name(href=url_for('/'))
      if theme.nav_logo
        img.site-logo(src=url_for(theme.nav_logo) alt=config.title)
      else
        =config.title
    
  #menus
    if (theme.algolia_search.enable || theme.local_search.enable)
      #search-button
        a.site-page.social-icon.search
          i.fas.fa-search.fa-fw
          span=' '+_p('search')
    !=partial('includes/header/menu_item', {}, {cache: true})

    #toggle-menu
      a.site-page
        i.fas.fa-bars.fa-fw


