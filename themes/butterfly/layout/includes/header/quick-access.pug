-
  var exploreData = site.data && site.data.explore ? site.data.explore : {}
  var exploreGroups = exploreData.groups || []

section#vexpaer-quick-access.vexpaer-explore-stack(aria-label='Keep exploring')
  each group in exploreGroups
    -
      var groupAnchor = group.anchor || ('vexpaer-explore-' + group.id)
      var groupTitleId = groupAnchor + '-title'

    section.vexpaer-explore(
      id=groupAnchor
      data-explore-root
      data-home-panel='explore-' + group.id
      data-group=group.id
      aria-labelledby=groupTitleId
    )
      .vexpaer-explore__inner
        header.vexpaer-explore__head
          p.vexpaer-explore__label(data-reveal)
            span= group.order
            span= group.eyebrow
          h2(id=groupTitleId data-reveal)= group.title
          p.vexpaer-explore__lead(data-reveal)= group.lead

        ol.vexpaer-explore__list
          each project, projectIndex in group.projects
            - var projectNumber = projectIndex + 1
            li(data-reveal style='--project-accent:' + project.accent)
              a.vexpaer-explore__item(
                href=project.href
                target='_blank'
                rel='noopener noreferrer'
                aria-label=project.name + ', ' + project.medium + ': ' + project.summary + ' (opens in a new window)'
              )
                span.vexpaer-explore__index= projectNumber < 10 ? '0' + projectNumber : projectNumber
                span.vexpaer-explore__name= project.name
                span.vexpaer-explore__medium= project.medium
                span.vexpaer-explore__summary= project.summary
                span.vexpaer-explore__path
                  code= project.path_label
                  i(aria-hidden='true') ↗
