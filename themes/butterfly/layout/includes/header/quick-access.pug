-
  var exploreData = site.data && site.data.explore ? site.data.explore : {}
  var quickLinks = exploreData.groups || []

section#vexpaer-quick-access.vexpaer-quick-access(aria-labelledby='vexpaer-quick-access-title' data-home-panel='links')
  .vexpaer-quick-access__inner
    header.vexpaer-quick-access__header
      span 02 / EXPLORE
      h2#vexpaer-quick-access-title 继续探索
      p 三条探索路线，通往五个收藏、工具与互动空间。
    .vexpaer-quick-access__grid
      each item, index in quickLinks
        a.vexpaer-quick-card(
          href=url_for(item.path)
          style='--quick-accent:' + item.accent + ';--quick-glow:' + item.glow
          aria-label='探索' + item.home.name
        )
          span.vexpaer-quick-card__index(aria-hidden='true')= item.order || ('0' + (index + 1))
          span.vexpaer-quick-card__visual(aria-hidden='true')
            i
            i
            i
          span.vexpaer-quick-card__content
            strong= item.home.name
            small= item.home.note
            code= item.home.code
          span.vexpaer-quick-card__arrow(aria-hidden='true') →
