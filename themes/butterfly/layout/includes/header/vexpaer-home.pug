#vexpaer-home(data-scene='dusk')
  canvas#vexpaer-home-canvas(aria-hidden='true')
  canvas#vexpaer-home-webgl(aria-hidden='true')
  iframe#vexpaer-home-turing(
    data-src=url_for('/html/turing-theme.html')
    title='Turing pattern background'
    aria-hidden='true'
    tabindex='-1'
  )
  iframe#vexpaer-home-ink(
    data-src=url_for('/html/ink-sailing-ship.html')
    title='Pen-and-ink sailing ship background'
    aria-hidden='true'
    tabindex='-1'
  )
  iframe#vexpaer-home-contours(
    data-src=url_for('/html/contour-mountains.html')
    title='Contour mountain background'
    aria-hidden='true'
    tabindex='-1'
  )
  .vexpaer-home__shade(aria-hidden='true')
  h1#vexpaer-home-title
    span.vexpaer-home-title__text= config.title
  button#vexpaer-scene-toggle(type='button' aria-label='Background: Dusk. Click to switch to Deep Space')
    span.vexpaer-scene-toggle__icon(aria-hidden='true') ◒
