extends includes/layout.pug

block content
  section.mh(data-mindmap-hub)
    .mh-map
      .mh-bar
        h1.mh-crumbs(data-mh-crumbs) Mindmap
        p.mh-status(data-mh-status role='status') Loading…
        .mh-tools(role='group' aria-label='Mindmap tools')
          .mh-seg(role='group' aria-label='Layout')
            button.mh-seg-item(type='button' data-mh-layout='both' aria-pressed='true' title='Both sides' aria-label='Both sides')
              svg(viewBox='0 0 24 12' width='22' height='11' aria-hidden='true')
                path(d='M2 6h20M2 2v8M22 2v8' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round')
                circle(cx='12' cy='6' r='2.6' fill='currentColor')
            button.mh-seg-item(type='button' data-mh-layout='right' aria-pressed='false' title='Right only' aria-label='Right only')
              svg(viewBox='0 0 24 12' width='22' height='11' aria-hidden='true')
                path(d='M5 6h17M22 2v8' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round')
                circle(cx='5' cy='6' r='2.6' fill='currentColor')
          button.mh-tool(type='button' data-mh-action='zoom-out' title='Zoom out' aria-label='Zoom out') −
          button.mh-tool(type='button' data-mh-action='zoom-in' title='Zoom in' aria-label='Zoom in') +
          button.mh-tool(type='button' data-mh-action='fit' title='Fit to view') Fit
      svg.mh-svg.markmap(data-mh-svg role='img' aria-label='Mindmap of all notes')

    aside.mh-side
      section.mh-panel.mh-outline-panel(aria-label='Outline')
        header.mh-panel-head
          h2 Outline
          button.mh-link(type='button' data-mh-action='collapse-outline' title='Collapse outline') Collapse
        .mh-outline(data-mh-outline role='tree')

      section.mh-panel.mh-graph-panel(data-mh-graph-panel aria-label='Graph')
        header.mh-panel-head
          h2 Graph
          span.mh-head-end
            span.mh-count(data-mh-count)
            button.mh-icon(type='button' data-mh-action='graph-max' aria-pressed='false' title='Expand graph' aria-label='Expand graph')
              svg.mh-icon-expand(viewBox='0 0 16 16' width='14' height='14' aria-hidden='true')
                path(d='M9.5 2.5h4v4M13.5 2.5 9 7M6.5 13.5h-4v-4M2.5 13.5 7 9' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round')
              svg.mh-icon-shrink(viewBox='0 0 16 16' width='14' height='14' aria-hidden='true')
                path(d='M13.5 6.5h-4v-4M9.5 6.5l4.5-4.5M2.5 9.5h4v4M6.5 9.5 2 14' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round')
        .mh-graph(data-mh-graph)
          canvas(data-mh-canvas aria-hidden='true')
          .mh-tip(data-mh-tip hidden)

    .mh-menu(data-mh-menu role='menu' hidden)
      .mh-menu-name(data-mh-menu-name)
      button(type='button' role='menuitem' data-mh-menu-item='root') 设为根节点
      button(type='button' role='menuitem' data-mh-menu-item='expand') 全部展开
      button(type='button' role='menuitem' data-mh-menu-item='collapse') 全部收缩

    script(type='application/json' data-mh-data)!=page.mindmap_hub_data
    noscript
      p.mh-noscript 需要启用 JavaScript 才能显示思维导图。
